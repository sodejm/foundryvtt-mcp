{
  "name": "foundryvtt-mcp",
  "version": "1.5.3",
  "description": "Model Context Protocol server for FoundryVTT integration",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./foundry/types": {
      "types": "./dist/foundry/types.d.ts",
      "import": "./dist/foundry/types.js"
    },
    "./foundry/read-contract": {
      "types": "./dist/foundry/read-contract.d.ts",
      "import": "./dist/foundry/read-contract.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "foundryvtt-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-test.js",
    "smoke:dotenv": "node scripts/smoke-dotenv.js",
    "smoke:pack": "node scripts/smoke-pack.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:reads:coverage": "npm run test:coverage -- --coverage.include=src/foundry/read-contract.ts --coverage.include=src/foundry/item-economy-contract.ts --coverage.include=src/foundry/item-normalization.ts --coverage.include=src/foundry/item-economy-read.ts --coverage.include=src/tools/handlers/actors.ts --coverage.include=src/tools/handlers/items.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --watch --config vitest.integration.config.ts",
    "test:integration:ui": "vitest --ui --config vitest.integration.config.ts",
    "test:workflow": "npm run build && vitest run --config vitest.workflow.config.ts",
    "test:remote-stdio": "npm run build && node scripts/remote-stdio-check.mjs",
    "test:integration:docker": "node scripts/integration-docker.mjs",
    "test-connection": "tsx scripts/test-connection.ts",
    "setup-wizard": "tsx scripts/setup-wizard.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "docs:check": "typedoc --emit none",
    "clean": "rimraf dist",
    "docs": "typedoc src/index.ts --out docs --exclude '**/*.test.ts'",
    "docs:serve": "npm run docs && npx http-server docs",
    "setup": "npm run clean && npm run build && npm run test-connection",
    "prepare": "husky",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "foundry",
    "vtt",
    "mcp",
    "ai",
    "tabletop",
    "rpg"
  ],
  "author": "Lauri Gates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurigates/foundryvtt-mcp.git"
  },
  "homepage": "https://github.com/laurigates/foundryvtt-mcp#readme",
  "bugs": {
    "url": "https://github.com/laurigates/foundryvtt-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/index-old.*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "parse5": "8.1.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "express-rate-limit": "^8.5.1",
    "ip-address": "^10.7.6",
    "path-to-regexp": "^8.4.2",
    "fast-uri": "^3.1.9",
    "socket.io-parser": "^4.2.7",
    "vite": "^7.3.7",
    "esbuild": "^0.28.1",
    "rollup": "^4.60.3",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.16",
    "linkify-it": "^5.0.2",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.12",
    "form-data": "^4.0.6",
    "ws": "^8.21.0",
    "markdown-it": "^14.3.3",
    "minimatch": "^11.0.9",
    "qs": "^6.17.1",
    "body-parser": "^2.4.0",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "src/**/*.{json,css,md}": [
      "biome format --write"
    ]
  },
  "patchedDependencies": {
    "typedoc@0.28.20": "patches/typedoc@0.28.20.patch"
  }
}
