# Integration test environment variables
# Copy to .env.integration and fill in your values

# Required: Your FoundryVTT license key
FOUNDRY_LICENSE_KEY=your-license-key

# Test credentials (these are created in the test container)
FOUNDRY_USERNAME=test-user
FOUNDRY_PASSWORD=test-password

# FoundryVTT URL (matches docker-compose.test.yml port mapping)
FOUNDRY_URL=http://localhost:30001

# Complete journal tests require the local disposable test1world controller.
# Start it after building: node scripts/journal-test-control.mjs
FOUNDRY_JOURNAL_TEST_CONTROL_URL=http://127.0.0.1:3012
# Optional controller settings:
# FOUNDRY_JOURNAL_TEST_CONTROL_PORT=3012
# FOUNDRY_JOURNAL_TEST_PROFILE=/private/tmp/foundry-journal-browser-profile

# Do NOT set FOUNDRY_VERSION here -- it would have no effect. Compose resolves
# `${FOUNDRY_VERSION:-...}` in docker-compose.test.yml from the shell environment
# and a project-root `.env`, never from an `env_file:` entry, and the value in
# that file's `environment:` block overrides `env_file:` in any case.
# To run the tier against another build, export it for the one command:
#   FOUNDRY_VERSION=14.368 just test-integration-docker
